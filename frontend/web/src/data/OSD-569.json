{"schema":"ahi.osdr.labpanel.v1","record":{"id":"osdr-osd-569-cbc","source_name":"NASA Open Science Data Repository (OSDR)","source_url":"https://osdr.nasa.gov/bio/repo/data/studies/OSD-569","dataset_accession":"OSD-569","dataset_version":"OSDR metadata version 4","title":"Whole Blood Measurements from the SpaceX Inspiration4 Mission (RNA-seq, epitranscriptome, WGS, clonal hematopoiesis, CBC)","downloaded_at":"2026-11-14T11:37:04.999Z","license":null,"access_classification":"Public, open access (downloaded without authentication). Processed tabular data.","file_name":"LSDS-7_Complete_Blood_Count_CBC.upload_SUBMITTED.csv","sha256":"10a878b009eb2ea11a13fe92ad698098858639e8ed02f5ee849431313b9457d3","parser_version":"ahi-osdr-import 1.0.0","study_population":"4 crew members (C001, C002, C003, C004): 2 female, 2 male per sample metadata. Study description: \"four private astronauts\". Age: not stated.","mission":"SpaceX Inspiration4 (9/16/21 to 9/18/21)","study_design":"Repeated measures on the same 4 subjects at 7 ground time points. Study factors: Time, Spaceflight. Design descriptor: low Earth orbit.","collection_phase":"Pre-flight (L-92, L-44, L-3) and post-flight (R+1, R+45, R+82, R+194). No in-flight samples in this file.","notes":"Complete blood count (CBC) from Whole blood (K2 EDTA tube). L-n = n days before launch, R+n = n days after return (as labeled in the source). Reference ranges are the lab ranges reported in the source file, not NASA limits. License: not stated in the study metadata.","data_origin":"REAL_PUBLIC"},"study":{"accession":"OSD-569","title":"Whole Blood Measurements from the SpaceX Inspiration4 Mission (RNA-seq, epitranscriptome, WGS, clonal hematopoiesis, CBC)","description":"The SpaceX Inspiration4 mission was a 3-day mission with four private astronauts to low Earth orbit that occurred in September 2021. The crew collected biospecimen samples before, during, and after flight. One of these biospecimen collections included whole blood collected via venipuncture into PaxGene Blood RNA tubes (BD Biosciences, #762165), collected pre-flight (L-92, L-44, L-3) and post-flight (R+1, R+45, R+82, R+194). Total RNA was purified from each tube and mRNA was sequenced using the Oxford Nanopore Technologies direct RNA-sequencing kit on the PromethION. Data was used to generate differential gene expression profiles and annotate sites of m6A modification. Additionally, whole genome sequencing was performed on crew members at L-44 and R+45 and a clonal hematopoiesis panel was performed on a subset of 9 genes (DNMT3A, TET2, ASXL1, TP53, CHEK2, JAK2, SRSF2, SF3B1, PPM1D). For these, DNA was isolated from the pellet of a cfDNA blood collection tube (Streck, cat #230470) (L-44, L-3, R+1, R+45, R+82, R+194). Finally, whole blood collected in K2 EDTA tubes (BD Biosciences, cat# 367844) were submitted to Quest Diagnostics for a complete blood count at all ground timepoints (L-92, L-44, L-3, R+1, R+45, R+82, R+194).","release_date":"14-May-2024","mission":{"name":"SpaceX Inspiration4","start":"9/16/21","end":"9/18/21"},"publications":[{"title":"The Space Omics and Medical Atlas (SOMA) and international astronaut biobank","doi":"10.1038/s41586-024-07639-y"},{"title":"Direct RNA sequencing of astronauts reveals spaceflight-associated m6A increases and hematopoietic transcriptional responses","doi":"10.1038/s41467-024-48929-3"},{"title":"Collection of Biospecimens from the Inspiration4 Mission Establishes the Standards for the Space Omics and Medical Atlas (SOMA)","doi":"10.1038/s41467-024-48806-z"},{"title":"Genome and clonal hematopoiesis stability contrasts with immune, cfDNA, mitochondrial, and telomere length changes during short duration spaceflight.","doi":"10.1093/pcmedi/pbae007"},{"title":"CAMbank: cfDNA BCT Field Processing v1","doi":"10.17504/protocols.io.6qpvr33yovmk/v1"}],"related_accessions":[],"study_url":"https://osdr.nasa.gov/bio/repo/data/studies/OSD-569","meta_api_url":"https://osdr.nasa.gov/osdr/data/osd/meta/569"},"file":{"file_name":"LSDS-7_Complete_Blood_Count_CBC.upload_SUBMITTED.csv","url":"https://osdr.nasa.gov/geode-py/ws/studies/OSD-569/download?source=datamanager&file=LSDS-7_Complete_Blood_Count_CBC.upload_SUBMITTED.csv","size_bytes":26138,"sha256":"10a878b009eb2ea11a13fe92ad698098858639e8ed02f5ee849431313b9457d3","downloaded_at":"2026-11-14T11:37:04.999Z"},"panel":{"name":"Complete blood count (CBC)","test_type":"CBC","specimen":"Whole blood (K2 EDTA tube)","protocol":"One 4mL tube of whole blood collected in a K2EDTA tube (BD Biosciences, Cat. 367844) was submitted to Quest Diagnostics, test code 6399. The Sysmex XN analyzer performs hematology analysis according to the hydrodynamic focusing (DC Detection), flow cytometry method (semiconductor laser), and SLS hemoglobin method."},"subjects":[{"id":"C001","sex":"M"},{"id":"C002","sex":"F"},{"id":"C003","sex":"F"},{"id":"C004","sex":"M"}],"timepoints":[{"label":"L-92","phase":"PRE_FLIGHT","days":-92,"reference":"launch"},{"label":"L-44","phase":"PRE_FLIGHT","days":-44,"reference":"launch"},{"label":"L-3","phase":"PRE_FLIGHT","days":-3,"reference":"launch"},{"label":"R+1","phase":"POST_FLIGHT","days":1,"reference":"return"},{"label":"R+45","phase":"POST_FLIGHT","days":45,"reference":"return"},{"label":"R+82","phase":"POST_FLIGHT","days":82,"reference":"return"},{"label":"R+194","phase":"POST_FLIGHT","days":194,"reference":"return"}],"analytes":[{"key":"WHITE BLOOD CELL COUNT","label":"White blood cell count","source_names":["WHITE BLOOD CELL COUNT"],"unit":"Thousand/uL","values":{"C001":[{"v":5.4,"lo":3.8,"hi":10.8},{"v":5.5,"lo":3.8,"hi":10.8},{"v":7,"lo":3.8,"hi":10.8},{"v":5,"lo":3.8,"hi":10.8},{"v":4.9,"lo":3.8,"hi":10.8},{"v":4.9,"lo":3.8,"hi":10.8},{"v":4.9,"lo":3.8,"hi":10.8}],"C002":[{"v":6.5,"lo":3.8,"hi":10.8},{"v":5.4,"lo":3.8,"hi":10.8},{"v":7.2,"lo":3.8,"hi":10.8},{"v":5.5,"lo":3.8,"hi":10.8},{"v":6.4,"lo":3.8,"hi":10.8},{"v":5.3,"lo":3.8,"hi":10.8},{"v":6.4,"lo":3.8,"hi":10.8}],"C003":[{"v":9.6,"lo":3